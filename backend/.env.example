HOST=0.0.0.0
PORT=8080
DATABASE_URL=mysql://root:your-password@metro.proxy.rlwy.net:16320/railway
DB_ENABLED=true
DB_HOST=metro.proxy.rlwy.net
DB_PORT=16320
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=railway
DB_POOL_SIZE=10
REDIS_ENABLED=false
REDIS_URL=redis://your-redis-host:6379
REDIS_GRAPH_TTL_SECONDS=3600
REDIS_ROUTE_TTL_SECONDS=600
JWT_SECRET=change-this-in-production
AUTH_TOKEN_TTL_HOURS=168
AUTH_JWT_ISSUER=goli-transit
RESET_TOKEN_TTL_MINUTES=30
RESET_CODE_TTL_MINUTES=10
RESET_CODE_RESEND_COOLDOWN_SECONDS=45
FRONTEND_URL=https://your-frontend.vercel.app
APP_URL=https://your-backend.onrender.com
APP_NAME=Goli-Transit
MAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
TOMTOM_API_KEY=your-tomtom-api-key
